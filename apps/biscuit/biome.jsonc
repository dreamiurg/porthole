{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": ["**/*.js", "**/*.mjs", "!node_modules", "!build", "!output", "!firmware/.pio"]
  },
  // Lint only: the code keeps its existing style, formatting is not enforced.
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // Concise `forEach(x => d.line(...))` arrows are the pixel-drawing idiom here; the discarded return value is never a bug.
        "useIterableCallbackReturn": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 15 } }
      }
    }
  }
}
